generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DB_URL")
}

model portfolios {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  thumbnail    String    
  created_by   String    @db.ObjectId
  website_link String    
  github_link  String?   
  title        String    
  description  String?   
  type         String    @default("frontend")
  file_name    String?   
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  users        users     @relation(fields: [created_by], references: [id])
  reviews      reviews[]

  @@index([created_by])
}

model reviews {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  comment      String?    
  rating       Int        @default(10)
  portfolio_id String     @db.ObjectId
  rated_by     String     @db.ObjectId
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  portfolios   portfolios @relation(fields: [portfolio_id], references: [id], onDelete: Cascade)
  users        users      @relation(fields: [rated_by], references: [id])

  @@index([portfolio_id])
  @@index([rated_by])
}

model users {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  githubUsername String?      
  username       String?      
  email          String       
  password       String?      
  role           String?      @default("user")
  profilePic     String?      
  provider       String?      
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  portfolios     portfolios[]
  reviews        reviews[]
}